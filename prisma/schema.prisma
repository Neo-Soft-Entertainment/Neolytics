  organizationId  String
  legalEntityId   String?
  projectId       String?
  type            CompanyDocumentType
  status          CompanyDocumentStatus    @default(DRAFT)
  title           String
  description     String?
  issuer          String?
  documentNumber  String?
  issuedAt        DateTime?
  expiresAt       DateTime?
  tags            Json?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  legalEntity     LegalEntity?             @relation(fields: [legalEntityId], references: [id], onDelete: SetNull)
  project         Project?                 @relation(fields: [projectId], references: [id], onDelete: SetNull)
  versions        CompanyDocumentVersion[]
  complianceItems ComplianceItem[]

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([legalEntityId, createdAt(sort: Desc)])
  @@index([projectId, createdAt(sort: Desc)])
  @@index([type, status])
  @@index([expiresAt])
}

model CompanyDocumentVersion {
  id           String          @id @default(cuid())
  documentId   String
  version      Int
  storagePath  String
  originalName String
  mimeType     String
  sizeBytes    Int?
  checksum     String?
  uploadedById String?
  createdAt    DateTime        @default(now())
  document     CompanyDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy   User?           @relation("CompanyDocumentVersionUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@unique([documentId, version])
  @@index([documentId, createdAt(sort: Desc)])
  @@index([uploadedById, createdAt(sort: Desc)])
}

model ComplianceItem {
  id               String           @id @default(cuid())
  organizationId   String
  legalEntityId    String?
  projectId        String?
  sourceDocumentId String?
  ownerUserId      String?
  type             ComplianceType
  status           ComplianceStatus @default(PENDING)
  title            String
  description      String?
  dueAt            DateTime?
  completedAt      DateTime?
  notes            String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  legalEntity      LegalEntity?     @relation(fields: [legalEntityId], references: [id], onDelete: SetNull)
  project          Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  sourceDocument   CompanyDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  ownerUser        User?            @relation("ComplianceItemOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, status, dueAt])
  @@index([legalEntityId, status, dueAt])
  @@index([projectId, status, dueAt])
  @@index([ownerUserId, status, dueAt])
}

model AuditEvent {
  id             String       @id @default(cuid())
  organizationId String
  userId         String?
  entityType     String
  entityId       String
  action         String
  metadata       Json?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

model UserConsent {
  id                 String        @id @default(cuid())
  userId             String
  purposeId          String
  consentTextVersion String
  status             ConsentStatus @default(GRANTED)
  grantedAt          DateTime      @default(now())
  revokedAt          DateTime?
  expiresAt          DateTime?
  source             String
  ipHash             String?
  userAgentHash      String?
  metadata           Json?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, purposeId])
  @@index([status, updatedAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

model DataSubjectRequest {
  id             String                   @id @default(cuid())
  userId         String
  organizationId String?
  requestType    DataSubjectRequestType
  status         DataSubjectRequestStatus @default(OPEN)
  reason         String?
  dueAt          DateTime
  completedAt    DateTime?
  handledById    String?
  resolution     String?
  metadata       Json?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  user           User                     @relation("DataSubjectRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  handledBy      User?                    @relation("DataSubjectRequestHandler", fields: [handledById], references: [id], onDelete: SetNull)
  organization   Organization?            @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([organizationId, status, dueAt])
  @@index([handledById, status, dueAt])
}

model PrivacyLegalHold {
  id               String                     @id @default(cuid())
  organizationId   String?
  resourceType     String
  resourceId       String
  reason           String
  deletionStrategy RetentionDeletionStrategy?
  active           Boolean                    @default(true)
  createdById      String?
  releasedAt       DateTime?
  metadata         Json?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  organization     Organization?              @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdBy        User?                      @relation("PrivacyLegalHoldCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, active, createdAt(sort: Desc)])
  @@index([resourceType, resourceId, active])
}

model PrivacyIncident {
  id                            String                  @id @default(cuid())
  organizationId                String?
  severity                      PrivacyIncidentSeverity
  affectedDataCategories        Json
  affectedUserCountEstimate     Int?
  discoveredAt                  DateTime
  containedAt                   DateTime?
  rootCause                     String?
  mitigationSteps               String?
  requiresAuthorityNotification Boolean                 @default(false)
  requiresUserNotification      Boolean                 @default(false)
  status                        PrivacyIncidentStatus   @default(OPEN)
  createdById                   String?
  createdAt                     DateTime                @default(now())
  updatedAt                     DateTime                @updatedAt
  organization                  Organization?           @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdBy                     User?                   @relation("PrivacyIncidentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, severity, createdAt(sort: Desc)])
  @@index([status, discoveredAt(sort: Desc)])
}

model DataProduct {
  id                         String               @id @default(cuid())
  organizationId             String?
  productName                String
  productType                DataProductType
  description                String
  sourceTables               Json
  outputFields               Json
  aggregationLevel           String?
  minimumCohortSize          Int                  @default(100)
  privacyRiskScore           Int                  @default(0)
  exportAllowed              Boolean              @default(false)
  requiresLegalReview        Boolean              @default(true)
  requiresDpoApproval        Boolean              @default(true)
  contractRequired           Boolean              @default(true)
  reidentificationProhibited Boolean              @default(true)
  approvalStatus             ApprovalStatus       @default(PENDING)
  approvedAt                 DateTime?
  approvedById               String?
  buyerContractAccepted      Boolean              @default(false)
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  organization               Organization?        @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  approvedBy                 User?                @relation("DataProductApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  exportManifests            DataExportManifest[]

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([productType, approvalStatus])
}

model DataExportManifest {
  id                 String          @id @default(cuid())
  organizationId     String?
  productId          String
  requestedById      String?
  buyerName          String
  buyerEmail         String?
  contractAcceptedAt DateTime?
  decision           PrivacyDecision
  reason             String?
  manifest           Json
  downloadedAt       DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  organization       Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  product            DataProduct     @relation(fields: [productId], references: [id], onDelete: Cascade)
  requestedBy        User?           @relation("DataExportManifestRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([productId, createdAt(sort: Desc)])
}

model PrivacyAuditLog {
  id             String           @id @default(cuid())
  organizationId String?
  actorId        String?
  actorRole      String?
  action         String
  resourceType   String
  resourceId     String?
  decision       PrivacyDecision?
  reason         String?
  metadata       Json?
  createdAt      DateTime         @default(now())
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor          User?            @relation("PrivacyAuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([resourceType, resourceId, createdAt(sort: Desc)])
}

model ProjectAnalysis {
  id                 String   @id @default(cuid())
  projectId          String   @unique
  analyzedAt         DateTime @default(now())
  matchingGamesCount Int
  competitionCount   Int
  releaseMomentum    Int
  averageReviewScore Float?
  averagePriceCents  Int?
  medianRevenueCents BigInt?
  marketSummary      String
  opportunitySummary String
  riskSummary        String
  audienceAutofill   String?
  coreLoopAutofill   String?
  suggestedGenres    Json?
  suggestedTags      Json?
  differentiators    Json?
  metadata           Json?
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectArtAnalysis {
  id                        String   @id @default(cuid())
  projectId                 String   @unique
  analyzedAt                DateTime @default(now())
  distinctivenessScore      Int
  productionComplexityScore Int
  marketFitScore            Int
  visualTrendScore          Int
  styleSummary              String
  fitSummary                String
  productionSummary         String
  recommendationSummary     String
  paletteKeywords           Json?
  moodKeywords              Json?
  metadata                  Json?
  project                   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ProjectArtAsset {
  id            String   @id @default(cuid())
  projectId     String
  uploadedById  String
  kind          String   @default("reference")
  storagePath   String
  originalName  String
  mimeType      String
  sizeBytes     Int
  width         Int?
  height        Int?
  visualMetrics Json?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt(sort: Desc)])
  @@index([uploadedById, createdAt(sort: Desc)])
}

model ProjectCompetitorGame {
  projectId   String
  steamGameId String

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  steamGame SteamGame @relation(fields: [steamGameId], references: [id], onDelete: Cascade)

  @@id([projectId, steamGameId])
  @@index([steamGameId])
}

model ProjectGdd {
  id        String   @id @default(cuid())
  projectId String
  version   Int      @default(1)
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt(sort: Desc)])
}

model KanbanBoard {
  id        String         @id @default(cuid())
  projectId String
  name      String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  columns   KanbanColumn[]

  @@index([projectId, createdAt(sort: Desc)])
}

model KanbanColumn {
  id        String       @id @default(cuid())
  boardId   String
  name      String
  color     String?
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  board     KanbanBoard  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards     KanbanCard[]

  @@index([boardId, sortOrder])
}

model KanbanCard {
  id            String       @id @default(cuid())
  columnId      String
  title         String
  description   String?
  assigneeLabel String?
  dueDate       DateTime?
  labels        Json?
  sortOrder     Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  column        KanbanColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)

  @@index([columnId, sortOrder])
}

model CommunityPost {
  id             String              @id @default(cuid())
  organizationId String
  workspaceId    String?
  authorId       String
  projectId      String?
  type           CommunityPostType   @default(GENERAL)
  title          String
  content        String
  tags           Json?
  media          Json?
  likeCount      Int                 @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace      Workspace?          @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  author         User                @relation("CommunityPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  project        Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  likes          CommunityPostLike[]

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([projectId, createdAt(sort: Desc)])
  @@index([authorId, createdAt(sort: Desc)])
}

model CommunityPostLike {
  postId    String
  userId    String
  createdAt DateTime      @default(now())
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId, createdAt(sort: Desc)])
}

model IngestionRun {
  id               String                     @id @default(cuid())
  organizationId   String?
  source           String
  sourceKey        String?
  status           IngestionStatus            @default(PENDING)
  message          String?
  attempts         Int                        @default(0)
  startedAt        DateTime                   @default(now())
  finishedAt       DateTime?
  organization     Organization?              @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  gameSnapshots    SteamGameSnapshot[]
  priceSnapshots   SteamPriceSnapshot[]
  reviewSnapshots  SteamReviewSnapshot[]
  playerSnapshots  SteamPlayerCountSnapshot[]
  salesEstimates   SalesEstimate[]
  revenueEstimates RevenueEstimate[]

  @@index([source, startedAt(sort: Desc)])
  @@index([status, startedAt(sort: Desc)])
}
