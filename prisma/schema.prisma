  MANAGE_WORKSPACES
  MANAGE_PROJECTS
  MANAGE_COMMERCE
  MANAGE_FINANCE
  MANAGE_COMPANY
  MANAGE_COMMUNITY
  MANAGE_PRIVACY
  EXPORT_DATA
}

