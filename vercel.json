{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/internal/steam-sync?mode=refresh",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/internal/steam-sync?mode=catalog&limit=25",
      "schedule": "0 */6 * * *"
    }
  ]
}
